<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg">

    <!-- MAIN IDE CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top IDE Toolbar Container (Extends behind Status Bar with padding) -->
        <LinearLayout
            android:id="@+id/ide_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_bg"
            android:orientation="vertical"
            android:elevation="4dp">

            <!-- Toolbar Controls Row (Always 52dp height, centered) -->
            <LinearLayout
                android:id="@+id/ide_toolbar_content"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Drawer Toggle (Files) -->
                <ImageView
                    android:id="@+id/btn_toggle_drawer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open Files"
                    android:padding="8dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/accent_blue" />

                <!-- Active File Title -->
                <TextView
                    android:id="@+id/tv_active_filename"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="hello.py" />

                <!-- Quick Terminal Toggle Button (Open/Close anytime) -->
                <ImageView
                    android:id="@+id/btn_toggle_terminal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Terminal"
                    android:padding="8dp"
                    android:src="@drawable/ic_terminal_small"
                    android:tint="@color/accent_blue" />

                <!-- Undo -->
                <ImageView
                    android:id="@+id/btn_undo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Undo"
                    android:padding="7dp"
                    android:src="@drawable/ic_undo"
                    android:tint="@color/text_secondary" />

                <!-- Redo -->
                <ImageView
                    android:id="@+id/btn_redo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Redo"
                    android:padding="7dp"
                    android:src="@drawable/ic_redo"
                    android:tint="@color/text_secondary" />

                <!-- Save File -->
                <ImageView
                    android:id="@+id/btn_save_file"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Save"
                    android:padding="7dp"
                    android:src="@drawable/ic_save"
                    android:tint="@color/text_primary" />

                <!-- Run Button (Vibrant Green) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_run_code"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="2dp"
                    android:backgroundTint="@color/accent_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="Run"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="13dp"
                    app:iconTint="@android:color/white" />

                <!-- More Options -->
                <ImageView
                    android:id="@+id/btn_ide_overflow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Horizontal Tabs Bar -->
        <LinearLayout
            android:id="@+id/layout_tabs_bar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/terminal_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ide_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <ImageView
                android:id="@+id/btn_new_scratch_tab"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="New File"
                android:padding="10dp"
                android:src="@drawable/ic_add_session"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color" />

        <!-- Center Workspace: Editor WebView -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/editor_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/terminal_bg" />

            <!-- Empty State / Welcome when no tabs open -->
            <LinearLayout
                android:id="@+id/layout_empty_welcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_code"
                    android:tint="@color/accent_blue"
                    android:contentDescription="IDE Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="MobileLinux Code IDE"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Open files from the left drawer, create a new script,\nor tap + to start coding."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_open_files"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/card_bg"
                    android:text="Open Project Explorer"
                    android:textColor="@color/accent_blue"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_folder"
                    app:iconTint="@color/accent_blue"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </FrameLayout>


        <!-- Bottom Execution Panel / Output Console -->
        <LinearLayout
            android:id="@+id/layout_execution_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0A0E14"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color" />

            <!-- Execution Header Bar (Acts as Drag Handle & Toggle) -->
            <LinearLayout
                android:id="@+id/layout_console_header"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@color/sidebar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="false"
                android:focusableInTouchMode="false">

                <!-- Toggle / Chevron Indicator -->
                <ImageView
                    android:id="@+id/btn_toggle_console"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Output"
                    android:src="@drawable/ic_terminal_small"
                    android:tint="@color/accent_blue" />

                <!-- Status / Title Text -->
                <TextView
                    android:id="@+id/tv_console_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="Console / Terminal"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Touch Drag Handle Pill in Center -->
                <View
                    android:id="@+id/drag_handle_indicator"
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_drag_handle" />

                <!-- Stop Button -->
                <ImageView
                    android:id="@+id/btn_stop_execution"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Stop Process"
                    android:padding="5dp"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/accent_red"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Clear Output -->
                <ImageView
                    android:id="@+id/btn_clear_console"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear Console"
                    android:padding="5dp"
                    android:src="@drawable/ic_trash"
                    android:tint="@color/text_secondary" />

                <!-- Close / Minimize Panel -->
                <ImageView
                    android:id="@+id/btn_close_console"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Minimize Console"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- Terminal Body (Collapsible & Draggable Resize with Real Linux Terminal) -->
            <FrameLayout
                android:id="@+id/layout_console_body"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Real Linux PRoot TerminalView -->
                <com.mobilelinux.terminal.TerminalView
                    android:id="@+id/ide_terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/terminal_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            </FrameLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- Dual-Layer Extra Keys Container (holds ExtraKeysView, padded from nav bar / soft keyboard) -->
        <FrameLayout
            android:id="@+id/extra_keys_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/extra_keys_bg">

            <com.mobilelinux.ui.ExtraKeysView
                android:id="@+id/extra_keys_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

    </LinearLayout>

    <!-- LEFT DRAWER: PROJECT & FILE EXPLORER -->
    <LinearLayout
        android:id="@+id/file_explorer_drawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/sidebar_bg"
        android:orientation="vertical">

        <!-- Drawer Header Container -->
        <LinearLayout
            android:id="@+id/drawer_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sidebar_header_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/accent_blue"
                    android:contentDescription="Explorer" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Project Files"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- Open Folder Button (Acode style) -->
                <ImageView
                    android:id="@+id/btn_drawer_open_folder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open Folder"
                    android:padding="6dp"
                    android:src="@drawable/ic_folder_open"
                    android:tint="@color/accent_blue" />

                <!-- New File -->
                <ImageView
                    android:id="@+id/btn_drawer_new_file"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="New File"
                    android:padding="6dp"
                    android:src="@drawable/ic_file_plus"
                    android:tint="@color/text_secondary" />

                <!-- New Folder -->
                <ImageView
                    android:id="@+id/btn_drawer_new_folder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="New Folder"
                    android:padding="6dp"
                    android:src="@drawable/ic_folder_plus"
                    android:tint="@color/text_secondary" />

                <!-- Refresh -->
                <ImageView
                    android:id="@+id/btn_drawer_refresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Refresh"
                    android:padding="6dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Current Project / Folder Banner & Up Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1B222C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Navigate to Parent Directory (Up) -->
            <ImageView
                android:id="@+id/btn_drawer_navigate_up"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Parent Folder"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_up"
                android:tint="@color/accent_yellow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_project_folder_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="ubuntu"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_project_folder_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="~/home/ubuntu"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Quick Change Folder Button -->
            <TextView
                android:id="@+id/btn_switch_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="[Change]"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color" />

        <!-- File Tree RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_file_tree"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
