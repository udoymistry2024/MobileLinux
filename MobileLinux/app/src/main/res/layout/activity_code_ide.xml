<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:fitsSystemWindows="true">

    <!-- MAIN IDE CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top IDE Toolbar -->
        <LinearLayout
            android:id="@+id/ide_toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/toolbar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Drawer Toggle (Files) -->
            <ImageView
                android:id="@+id/btn_toggle_drawer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open Files"
                android:padding="8dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/accent_blue" />

            <!-- Active File Title -->
            <TextView
                android:id="@+id/tv_active_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="main.py" />

            <!-- Undo -->
            <ImageView
                android:id="@+id/btn_undo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:padding="8dp"
                android:src="@drawable/ic_undo"
                android:tint="@color/text_secondary" />

            <!-- Redo -->
            <ImageView
                android:id="@+id/btn_redo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:padding="8dp"
                android:src="@drawable/ic_redo"
                android:tint="@color/text_secondary" />

            <!-- Save File -->
            <ImageView
                android:id="@+id/btn_save_file"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save"
                android:padding="8dp"
                android:src="@drawable/ic_save"
                android:tint="@color/text_primary" />

            <!-- Run Button (Vibrant Green) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_code"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/accent_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Run"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_play"
                app:iconSize="14dp"
                app:iconTint="@android:color/white" />

            <!-- More Options -->
            <ImageView
                android:id="@+id/btn_ide_overflow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Horizontal Tabs Bar -->
        <LinearLayout
            android:id="@+id/layout_tabs_bar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/terminal_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ide_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <ImageView
                android:id="@+id/btn_new_scratch_tab"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="New File"
                android:padding="10dp"
                android:src="@drawable/ic_add_session"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color" />

        <!-- Center Workspace: Editor WebView -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/editor_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/terminal_bg" />

            <!-- Empty State / Welcome when no tabs open -->
            <LinearLayout
                android:id="@+id/layout_empty_welcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_code"
                    android:tint="@color/accent_blue"
                    android:contentDescription="IDE Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="MobileLinux Code IDE"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Open files from the left drawer, create a new script,\nor tap + to start coding."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_open_files"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/card_bg"
                    android:text="Open File Explorer"
                    android:textColor="@color/accent_blue"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_folder"
                    app:iconTint="@color/accent_blue"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Touch Coding Accessory Bar (Quick Symbols above Keyboard) -->
        <HorizontalScrollView
            android:id="@+id/accessory_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/extra_keys_bg"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_accessory_keys"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

        </HorizontalScrollView>

        <!-- Bottom Execution Panel / Output Console -->
        <LinearLayout
            android:id="@+id/layout_execution_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0A0E14"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color" />

            <!-- Execution Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@color/sidebar_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- Toggle Panel Icon -->
                <ImageView
                    android:id="@+id/btn_toggle_console"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Output"
                    android:src="@drawable/ic_terminal_small"
                    android:tint="@color/accent_blue" />

                <!-- Status Text -->
                <TextView
                    android:id="@+id/tv_console_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:text="Console Output"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Stop Button -->
                <ImageView
                    android:id="@+id/btn_stop_execution"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Stop Process"
                    android:padding="5dp"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/accent_red"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Clear Output -->
                <ImageView
                    android:id="@+id/btn_clear_console"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear Console"
                    android:padding="5dp"
                    android:src="@drawable/ic_trash"
                    android:tint="@color/text_secondary" />

                <!-- Close / Minimize Panel -->
                <ImageView
                    android:id="@+id/btn_close_console"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Minimize Console"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- Console Body (Collapsible) -->
            <LinearLayout
                android:id="@+id/layout_console_body"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Output Text ScrollView -->
                <ScrollView
                    android:id="@+id/scroll_console_output"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_console_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="true"
                        android:textColor="#C9D1D9"
                        android:textSize="12sp"
                        tools:text="Process started...\nHello from Ubuntu 24.04 PRoot!\n" />

                </ScrollView>

                <!-- Interactive Stdin Row -->
                <LinearLayout
                    android:id="@+id/layout_stdin_row"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#12161E"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/accent_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_stdin_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Type input for program..."
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_stdin"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:backgroundTint="@color/accent_blue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Send"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        app:cornerRadius="6dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- LEFT DRAWER: FILE EXPLORER -->
    <LinearLayout
        android:id="@+id/file_explorer_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/sidebar_bg"
        android:orientation="vertical">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/sidebar_header_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/accent_blue"
                android:contentDescription="Explorer" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Files &amp; Projects"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- New File -->
            <ImageView
                android:id="@+id/btn_drawer_new_file"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="New File"
                android:padding="6dp"
                android:src="@drawable/ic_file_plus"
                android:tint="@color/text_secondary" />

            <!-- New Folder -->
            <ImageView
                android:id="@+id/btn_drawer_new_folder"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="New Folder"
                android:padding="6dp"
                android:src="@drawable/ic_folder_plus"
                android:tint="@color/text_secondary" />

            <!-- Refresh -->
            <ImageView
                android:id="@+id/btn_drawer_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:padding="6dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Root Directory Switcher (Linux Home vs Shared Storage) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#1B222C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_current_root_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Linux Home (~)"
                android:textColor="@color/accent_blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_switch_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="[Switch]"
                android:textColor="@color/accent_yellow"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color" />

        <!-- File Tree RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_file_tree"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
