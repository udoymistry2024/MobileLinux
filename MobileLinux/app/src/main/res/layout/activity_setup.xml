<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg"
    android:padding="32dp"
    android:gravity="center">

    <!-- Logo / Icon area -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_app_logo"
            android:contentDescription="MobileLinux Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MobileLinux"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubuntu 24.04 LTS on Android"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Welcome text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="First-time setup required.\n\nUbuntu 24.04 ARM64 environment will be configured on your device.\n\nThis takes a few minutes."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp" />

    <!-- Start button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_setup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setup Ubuntu Environment"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:cornerRadius="16dp"
        android:backgroundTint="@color/accent_blue" />

    <!-- Progress section (hidden initially) -->
    <LinearLayout
        android:id="@+id/layout_setup_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setting up..."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:gravity="center"
            android:fontFamily="@font/inter_medium" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent_blue"
            android:progressBackgroundTint="@color/divider_color" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Complete section (hidden initially) -->
    <LinearLayout
        android:id="@+id/layout_complete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Setup Complete!"
            android:textColor="@color/accent_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubuntu 24.04 is ready to use."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_launch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Launch Terminal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/accent_green" />
    </LinearLayout>

    <!-- Error message text (hidden initially, scrollable for long messages) -->
    <ScrollView
        android:id="@+id/error_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:layout_marginBottom="16dp">
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="8dp" />
    </ScrollView>

    <!-- Retry button (hidden initially) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retry Setup"
        android:visibility="gone"
        app:cornerRadius="16dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Hidden title for compat -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
