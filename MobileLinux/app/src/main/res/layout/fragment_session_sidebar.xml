<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sidebar_bg">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/sidebar_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/sidebar_header_bg">

        <!-- App icon + title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MobileLinux"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubuntu 24.04 ARM64"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Settings button -->
        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_secondary"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Sessions label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SESSIONS"
        android:textColor="@color/text_hint"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/inter_medium"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp" />

    <!-- Session list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Bottom Action Container -->
    <LinearLayout
        android:id="@+id/sidebar_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/sidebar_bg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_session"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="New Session"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_add_session"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/accent_blue"
            app:cornerRadius="10dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/card_bg"
            app:rippleColor="@color/ripple_color"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
    </LinearLayout>

</LinearLayout>
