<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_picker_path_bar">

    <!-- Top Row: Icon, Title, Version, Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_extension_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_extension"
            app:tint="@color/accent_blue"
            android:background="@drawable/bg_dialog_icon_circle"
            android:padding="6dp"
            android:contentDescription="Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_extension_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/inter_bold"
                    tools:text="Python Black Formatter" />

                <TextView
                    android:id="@+id/tv_extension_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_picker_path_bar"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_medium"
                    tools:text="v1.0.0" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_extension_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                tools:text="by MobileLinux Community" />

        </LinearLayout>

        <!-- Enable / Disable Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_extension_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />

    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tv_extension_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingExtra="2dp"
        tools:text="Automatically formats Python code using Black inside PRoot Linux." />

    <!-- Action Bar: Status & Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_extension_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:fontFamily="@font/inter_medium"
            android:text="Active &amp; Ready" />

        <ImageView
            android:id="@+id/btn_extension_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/accent_red"
            android:contentDescription="Uninstall Extension" />

    </LinearLayout>

</LinearLayout>
