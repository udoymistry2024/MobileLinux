<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_package_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row: Package Name & Version Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_pkg_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="JupyterLab &amp; Notebook" />

        <TextView
            android:id="@+id/tv_pkg_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_category_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Latest / Web IDE" />

    </LinearLayout>

    <!-- Category Tag -->
    <TextView
        android:id="@+id/tv_pkg_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/accent_purple"
        android:textSize="12sp"
        tools:text="🧠 AI &amp; Data Science" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_pkg_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="Interactive web-based notebooks, code cells, terminal, and visualization dashboard." />

    <!-- Action & Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status / Progress text -->
        <TextView
            android:id="@+id/tv_pkg_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            tools:text="Ready to install" />

        <!-- Installing Spinner Row -->
        <LinearLayout
            android:id="@+id/layout_installing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_blue" />

            <TextView
                android:id="@+id/tv_installing_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Installing..."
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Installed Badge -->
        <LinearLayout
            android:id="@+id/layout_installed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_installed_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Installed"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Optional Launch Button (e.g. for Jupyter) -->
        <Button
            android:id="@+id/btn_launch"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_purple"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Open Web"
            android:textAllCaps="false"
            android:textColor="@color/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Install Button -->
        <Button
            android:id="@+id/btn_install"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_blue"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Install"
            android:textAllCaps="false"
            android:textColor="@color/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
