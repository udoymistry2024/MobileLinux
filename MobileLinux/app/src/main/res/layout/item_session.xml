<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:minHeight="52dp"
    android:background="@drawable/bg_session_item">

    <!-- Active session indicator (left accent bar) -->
    <View
        android:id="@+id/view_active_indicator"
        android:layout_width="3dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_active_indicator"
        android:visibility="invisible" />

    <!-- Session icon -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_terminal_small"
        android:tint="@color/text_secondary" />

    <!-- Session info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_session_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/inter_medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Session 1" />

        <TextView
            android:id="@+id/tv_session_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:text="running" />
    </LinearLayout>

    <!-- Close button -->
    <ImageButton
        android:id="@+id/btn_session_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/text_hint"
        android:contentDescription="Close session" />

</LinearLayout>
